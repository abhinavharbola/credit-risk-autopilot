# --- MLflow tracking (DagsHub-hosted) ---
# separate credential pair from DVC, do not conflate (see 4.2)
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- DVC remote (DagsHub S3-compatible) ---
# DagsHub's remote is a fixed placeholder URL (s3://dvc), not a bucket you
# name yourself - the actual routing happens via a separate `dvc remote
# modify origin endpointurl https://dagshub.com/<user>/<repo>.s3` command,
# not an env var here. See README.md "Getting started" step 5.
# access_key_id and secret_access_key are the SAME DagsHub token, not a
# username/token pair.
DVC_ACCESS_KEY_ID=
DVC_SECRET_ACCESS_KEY=

# --- Postgres (Neon free tier) ---
# scheme must be postgresql+psycopg (not plain postgresql://) - we install
# psycopg v3, not psycopg2, and SQLAlchemy defaults to psycopg2 otherwise
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<db>?sslmode=require

# --- Tracing (Logfire) ---
LOGFIRE_TOKEN=

# --- LLM (single isolated decision-explanation call) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
